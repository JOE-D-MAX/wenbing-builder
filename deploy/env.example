# 复制为 deploy/.env（勿提交、勿截图、勿上传聊天）。
# 示例占位地址不是已注册域名，请换成自己购买且解析到服务器的域名。
DOMAIN=wenbing.example
TLS_EMAIL=you@example.com
FORMA_SUPPORT_EMAIL=you@example.com

# 网页支付应用尚未配置，保持 false。普通支付宝收款码不等于网页支付应用。
FORMA_SALES_ENABLED=false
# 开通并验收“手机网站支付”产品后才改为 true；电脑网站支付需先开通。
ALIPAY_WAP_PAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# PEM 可放在单引号中，换行写成字面量 \n；只在服务器私密环境中填写。
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
